# Comma-separated ChatGPT account emails allowed to access /admin.
MAREL_ADMIN_EMAILS=admin@example.com

# SoftTrade (Laravel) backend endpoint and admin service credentials.
SOFTRADE_API_URL=http://localhost:8081/api/v1
SOFTRADE_ADMIN_EMAIL=admin@softtrade.com
SOFTRADE_ADMIN_PASSWORD=admin123

# Google Ads values from the website conversion action.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-000000000
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=replace-with-conversion-label
