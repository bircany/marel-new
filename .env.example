# Comma-separated ChatGPT account emails allowed to access /admin.
MAREL_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_SITE_URL=https://marelpliseperde.com

# SoftTrade env adları Laravel backend (`backend/`) içindir.
SOFTRADE_API_URL=http://localhost:8081/api/v1
SOFTRADE_ADMIN_EMAIL=admin@softtrade.com
SOFTRADE_ADMIN_PASSWORD=admin123

# Varsayılan kargo firması (mng | yurtici | aras | surat | ptt | hepsijet | sendeo | other)
CARGO_DEFAULT_COMPANY=mng

# MNG Kargo / DHL eCommerce Turkey — ApiZone credential (opsiyonel; yoksa public takip URL kullanılır)
MNG_CARGO_ENABLED=false
MNG_CARGO_BASE_URL=https://testapi.mngkargo.com.tr
MNG_CARGO_CLIENT_ID=
MNG_CARGO_CLIENT_SECRET=
MNG_CARGO_CUSTOMER_NUMBER=
MNG_CARGO_PASSWORD=

# Comma-separated browser origins allowed for CORS (API proxy).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3006,http://127.0.0.1:3000

# Prod rate-limit (Upstash Redis REST). Boşsa in-memory (tek instance) kullanılır.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Havale / WhatsApp (storefront public fallback)
NEXT_PUBLIC_MAREL_IBAN=TR00 0000 0000 0000 0000 0000 00
NEXT_PUBLIC_MAREL_BANK_NAME=Marel Havale Hesabı
NEXT_PUBLIC_MAREL_ACCOUNT_HOLDER=Marel
NEXT_PUBLIC_MAREL_WHATSAPP=905467356602
NEXT_PUBLIC_MAREL_PAYMENT_NOTE=Açıklamaya sipariş numaranızı yazın. Dekontu WhatsApp üzerinden gönderin.

# Google Ads values from the website conversion action.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-000000000
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=replace-with-conversion-label
