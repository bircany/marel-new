!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
.marel-dev*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/scratch/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!SoftTrade/.env.example
!backend/.env.example

# Laravel backend
/SoftTrade/vendor/
/backend/vendor/
/SoftTrade/node_modules/
/backend/node_modules/
/SoftTrade/softtrade-client/
/backend/softtrade-client/
