{
  "name": "marel-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:storefront": "vinext dev --port 3000",
    "backend:up": "docker compose -f SoftTrade/docker-compose.yml up -d --build",
    "backend:down": "docker compose -f SoftTrade/docker-compose.yml down",
    "backend:logs": "docker compose -f SoftTrade/docker-compose.yml logs -f backend",
    "backend:ps": "docker compose -f SoftTrade/docker-compose.yml ps",
    "backend:install": "composer install --working-dir=backend",
    "backend:migrate": "cd backend && php artisan migrate --seed",
    "backend:serve": "cd backend && php artisan serve --host=127.0.0.1 --port=8081",
    "backend:key": "cd backend && php artisan key:generate",
    "backend:link": "cd backend && php artisan storage:link",
    "dev:backend": "npm run backend:up",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --experimental-loader ./tests/cloudflare-loader.mjs --test tests/rendered-html.test.mjs",
    "test:smoke": "node --test tests/smoke-local.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.mjs",
    "katalog:import": "node scripts/import-katalog-photos.mjs",
    "katalog:import:dry": "node scripts/import-katalog-photos.mjs --dry-run",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern SoftTrade --ignore-pattern backend",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@babel/helper-string-parser": "^7.27.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "unenv": "^2.0.0-rc.24",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
